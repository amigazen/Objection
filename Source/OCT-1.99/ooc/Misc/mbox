// Queue.h
// A FIFO object
//
// A minimal Queue implementation, just to make this sample program do
// something.
//
// Best edited with tabstop=3

#include <objc/Object.h>

// First, we declare a struct for an element for our Queue.  Actualliy,
// it's an implementation detail, but then, instance variable declararions
// are a kind of implementation details, too.

typedef struct _QueueEl
{
	id el;                   // the element itself
	struct _QueueEl *next;   // the pointer to the next element
} 
  QueueEl, *QueueElPtr;

@interface Queue:Object
{
	QueueElPtr first;       // always points fo first element
	QueueElPtr last;        // always points to the (empty) last element
	int size;               // element count
}

+ new;                     // create a new Queue instance
- put:object;              // add an object at the end of the queue
- get;                     // retrieve the first object
- (int)size;               // get the queue size
@end

