#import <objc/Object.h>

// This is a simple implementation of a Stack class,
// just so we could test the sample program.

@interface  Stack:Object
{
	int size;					// element count
	int allocatedSize;		// room for elements
	id *theArray;				// our resizable array
}

+ new;							// create a new Stack instance
- free;							// destroy the instance
- put:object;					// push an object on the stack
- get;							// pop an object off the stack
- (int)size;					// get the stack size
@end

-------------- 8< ---------------- 8< --------------- 8< -------------
// Stack.m
// a LIFO object
//
// Best edited with tabstop=3

#import <sys/types.h>
#import "Stack.h"

extern void* malloc(size_t);
extern void* realloc(void*, size_t);
extern free(void *);

#define DEFAULTSTACKSIZE 1024

@implementation Stack

+ new
{
	Stack * newStack;
	newStack = [super new];
	newStack->allocatedSize = DEFAULTSTACKSIZE;
	newStack->theArray = (id *)malloc(sizeof(id) * allocatedSize);
	if (!newStack->theArray)
		return [self error: "Could not new"];
	size = 0;
	return newStack;
}

// free the stack but not the elements
-free
{
	if (theArray) free(theArray);
}

// push an object on the stack
- put:object
{
	theArray[size] = object;
	if (++size > allocatedSize)
	{
		allocatedSize += DEFAULTSTACKSIZE;
		theArray = (id *)realloc(theArray, sizeof(id)*allocatedSize);
		if (!theArray)
			return [self error: "out of space"];
	}	
	return self;
}

// pop an object off the stack
- get
{
	if (size)
	{
		size--;
		if (!size && (allocatedSize > DEFAULTSTACKSIZE))
		{
			allocatedSize = DEFAULTSTACKSIZE;
			theArray = (id*)realloc(theArray, sizeof(id)*allocatedSize);
		}
		return theArray[size];
	}
	else
	{	
		if (allocatedSize > DEFAULTSTACKSIZE)
		{
			allocatedSize = DEFAULTSTACKSIZE;
			theArray = (id*)realloc(theArray, sizeof(id)*allocatedSize);
		}
		return nil;
	}
}

- (int)size;
{	
	return size;
}
@end

