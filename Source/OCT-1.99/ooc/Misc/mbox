// Queue.m
// Queue object: a FIFO
// 
// Best edited with tabstop=3

#import "Queue.h"
#import <sys/types.h>

extern void* malloc(size_t);
extern free(void *);

@implementation Queue

+ new
{
	Queue * newQueue;
	QueueElPtr newElPtr; 	// allocate a new element, will be "dummy"	
	newElPtr = (QueueElPtr)malloc(sizeof(QueueEl));
	if (!newElPtr) 			// if malloc failed
		return [self error:"Could not new"]; // complain

	newQueue = [super new]; 	// a new instance
	newQueue->size = 0;			// the new element is a dummy
	newQueue->first = newQueue->last = newElPtr;
	first->next = NULL; 			// just to be "tidy"
	return newQueue;				// we return the new instance
}

// free the queue but not the elements
- free
{
	if (first) free(first);
	if (last)  free(last);
	return [super free];
}

// add an object at the end of the queue
- put:object 
{
	QueueElPtr newElPtr;

	newElPtr = (QueueElPtr)malloc(sizeof(QueueEl));
	if (!newElPtr)
	{
		return [self error:"Out of space"];
	}
	last->el = object;		// the last element is always empty
	last->next = newElPtr;	// let's point to the new empty one
	last = newElPtr;			// which becomes the new last
	last->next = NULL;		// we are tidy, remember
	size++;						// we've added one element
	return self;				// remember: if you have nothing
									// interesting to return, return self!
}

// get the first element and delete it from the queue
- get
{
	id object;
	QueueElPtr tmp;
	if (size)
	{
		size--;
		object = first->el;
		tmp = first;
		first = first->next;
		free(tmp);
		return object;
	}
	else
	{	
		return nil;
	}
}

- (int)size
{	
	return size;
}

@end

