####################################################
#	:bk=0
#
#	Makefile for dependency graph example from Ch. 9,
#	Dr. Cox's OOP bbok [1986]. Defines the classes
#	Graph and Node.
#
#	This makefile takes .m files and moves directly into .o files.
#
#	This program may be debugged under MANX's sdb product like:
#		sdb -s/methods!/maker main16 depends
#	where -s specifies source directories.  Do a "G app_main",
#	start stepping message expressions!
#
#	Since the class libraries are updated periodically, you might
#	want a make rule to delete the executables.  Sometimes I copy
#	the class libraries to RAM: for faster access.
#
#	28-oct-89	bjw 	Adapted makefile.
#	12-jan-90	bjw 	Added tree.m series.
#	16-april-90	bjw 	Not dependent on oc-lib.
#	19-feb-91   bjw     UNIX verison of making.
#   Use LDFLAGS for linking, not LFLAGS (that's for LEX)
#       June 92,        bjw
#   20-nov-92   bjw     Added "norun" method.
#

## vvvvvvvvvvvvvvvvvvv  User Servicable Parts Follow  vvvvvvvvvvvvvvvvvv */

#A # ---- AMIGA  -------------------------------------
#A 
#A CC = cc
#A LN = ln
#A LEX = flex
#A LDFLAGS = -g
#A LIBS = -locCltn -locbase -locsubs 
#A DELETE = delete quiet
#A CLONE  = copy clone
#A RENAME = rename
#A CLIB   = tree.o -lc
#A 
#A TMPDIR = t:
#A OOCINC = ooc:include/
#A OOCBIN = Haven:bins/
#A # OOCLIB = ooc:include/
#A OOCLIB = LIB:
#A 
#A # -------------------------------------
#A 
#A #	Some actual include files:
#A TREEINC = dh4:usr/include/tree.h
#A RELEASE = $(OOCINC)objc/release.h
#A TEMP = $(TMPDIR)cpp-temp.c
#A 
#A #	The programs we create:
#A OCT = oct
#A PLN = prelink
#A OCT_CPP = oct-cpp
#A 
#A CLASSLIB = $(OOCLIB)ocbase.lib
#A SUBSLIB  = $(OOCLIB)ocsubs.lib
#A 
#A # STATS = -DSTAT_SWITCH
#A STATS  =
#A CFLAGS = $(MODEL) -n -DNO_PROTOTYPE
#A CF_STACK +m
#A 


# ---- UNIX  -------------------------------------

.SUFFIXES: .o .c .h .m

CC = cc -c
LN = cc
LEX = lex
# MODEL = -g
MODEL = 
LIBS = -locCltn -locbase -locsubs 
DELETE = rm -f
CLONE = cp
RENAME = mv
CLIB   =

TMPDIR = /usr/tmp/
OOCINC = $(HOME)/myoct/include/
OOCBIN = $(HOME)/bin/
OOCLIB = $(HOME)/myoct/lib/

LDFLAGS = $(MODEL) -L $(OOCLIB)

# -------------------------------------

#	Some actual include files:
TREEINC = $(OOCINC)tree.h
RELEASE = $(OOCINC)objc/release.h
TEMP = $(TMPDIR)cpp-temp.c

#	The programs we create:
OCT = oct
PLN = prelink
OCT_CPP = oct-cpp

CLASSLIB = $(OOCLIB)libocbase.a
SUBSLIB  = $(OOCLIB)libocsubs.a

# STATS = -DSTAT_SWITCH
STATS  =
CFLAGS = $(MODEL) -DNO_PROTOTYPE -I ../usr/include -I $(OOCINC)
CF_STACK =

##
## ^^^^^^^^^^^^^^^^  No User Servicable Parts Beyound  ^^^^^^^^^^^^^^^^^ */
##


# -------------------------------------

OBJS = Graph.o Node.o tree.o

ALL_METHODS = Graph.m Node.m tree.m


# -------------------------------------
#
#	--- New rules ---
#
#     (Seems SysVR2 won't place .o file where I want it, use rename.)
.m.o :
	$(OCT) -o $(TMPDIR)XX.c $*.m
	$(CC) $(CFLAGS) $(TMPDIR)XX.c
	$(RENAME) XX.o $*.o

#A .m.o :
#A 	$(OCT) -o $(TMPDIR)XX.c $*.m
#A	$(CC) $(CFLAGS) -o $*.o $(TMPDIR)XX.c

# -------------------------------------
#
#	--- Top Level Controls ---
#
all :	main16 hw16

clean :
	-$(DELETE) *.bak *.o main16 main16.dbg
	-$(DELETE) hw16 hw16.dbg

zoo :	zoofile

noruns :
	$(DELETE) main16 hw16 speed16

help :
	@echo "all  -- build dependency and hello-world examples."
	@echo "zoo  -- package source into .zoo file."
	@echo "clean -- delete backup and object files."
	@echo "noruns - delete produced executables only."

# -------------------------------------
#
#	--- project: MAIN ---
#
main16 :	$(OBJS) main.o ww.o
	$(LN) $(LDFLAGS) -o main16 $(OBJS) main.o ww.o $(LIBS) $(CLIB)

ww.o : 	ww.c
	$(CC) $(MODEL) ww.c

ww.c :	Makefile
	prelink ww.c main.m $(ALL_METHODS)

Graph.o :	Graph.m Graph.h
Node.o :	Node.m Node.h
tree.o :	tree.m
main.o :	main.m


# -------------------------------------
#
#	--- project: HELLO WORLD ---
#
hw16  :	newbyte.o hw.o ww_hw.o $(OBJS)
	$(LN) $(LDFLAGS) -o hw16 newbyte.o hw.o ww_hw.o $(OBJS) $(LIBS) $(CLIB)

ww_hw.o :	ww_hw.c
	$(CC) $(MODEL) ww_hw.c

ww_hw.c :
	prelink ww_hw.c hw.m tree.m newbyte.m


newbyte.o :	newbyte.m
hw.o :	hw.m


# -------------------------------------
#
#	--- project: Zoo file ---
#
zoofile :
	$(CLONE) Makefile mk-amiga
	zoo -add ram:D *.m *.h mk-amiga
	@$(DELETE) mk-amiga

